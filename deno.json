{
  "version": "5.0.9",
  "unstable": [
    "cron",
    "fs",
    "net"
  ],
  "tasks": {
    "launch-server": "deno run -A mod.ts start",
    "dev-server": "deno run -A --watch mod.ts start",
    "build-openapi": "deno run -A mod.ts openapi",
    "compile": "deno compile -A --output build/corets mod.ts",
    "compile-win": "deno compile -A --target x86_64-pc-windows-msvc --no-terminal --output build/corets.exe mod.ts",
    "compile-lin": "deno compile -A --target x86_64-unknown-linux-gnu --output build/corets mod.ts",
    "compile-lin-arm": "deno compile -A --target aarch64-unknown-linux-gnu --output build/corets mod.ts",
    "compile-mac": "deno compile -A --target x86_64-apple-darwin --output build/corets mod.ts",
    "compile-mac-m1": "deno compile -A --target aarch64-apple-darwin --output build/corets mod.ts",
    "test": "deno test -A tests"
  },
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "ban-untagged-todo"
      ],
      "exclude": [
        "no-unused-vars"
      ]
    }
  },
  "fmt": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "third_party/",
      "node_modules/",
      "cov/",
      "apps/",
      "vendor/",
      "data/",
      "users/",
      "cli/",
      "conf/"
    ]
  },
  "imports": {
    "./mod.ts": "./mod.ts",
    "@bradenmacdonald/s3-lite-client": "jsr:@bradenmacdonald/s3-lite-client@^0.9.6",
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    "@danet/core": "jsr:@danet/core@2.11.3",
    "@danet/swagger": "jsr:@danet/swagger@2.3.2",
    "@std/archive": "jsr:@std/archive@^0.225.4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/streams": "jsr:@std/streams@^1.1.1",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@2.8.34",
    "webdav": "npm:webdav",
    "mustache": "npm:mustache@4.2.0",
    "openpgp": "npm:openpgp@5.11.3",
    "https://deno.land/std/node/util.ts": "node:util",
    "https://deno.land/std/node/events.ts": "node:events",
    "https://deno.land/std/node/assert.ts": "node:assert",
    "https://deno.land/std/node/url.ts": "node:url",
    "https://deno.land/std/node/stream.ts": "node:stream"
  },
  "nodeModulesDir": "auto"
}
